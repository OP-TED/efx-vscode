{
  "name": "efx-vscode",
  "displayName": "EFX",
  "description": "Support for EFX, the expression and template language of the eForms SDK.",
  "version": "0.1.0",
  "publisher": "op-ted",
  "author": {
    "name": "Publications Office of the European Union",
    "email": "OP-TED-DEVOPS@publications.europa.eu"
  },
  "license": "EUPL-1.2",
  "homepage": "https://ted.europa.eu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OP-TED/efx-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/OP-TED/efx-vscode/issues"
  },
  "keywords": [
    "efx",
    "eforms"
  ],
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "efx",
        "aliases": [
          "EFX"
        ],
        "extensions": [
          ".efx"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "files": [
    "dist",
    "language-configuration.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "tsc && node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies",
    "pretest": "npm run package && node scripts/build.mjs --tests",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

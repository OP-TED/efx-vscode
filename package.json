{
  "name": "efx-vscode",
  "displayName": "EFX",
  "description": "Support for EFX, the expression and template language of the eForms SDK.",
  "version": "0.2.0",
  "publisher": "op-ted",
  "author": {
    "name": "Publications Office of the European Union",
    "email": "OP-TED-DEVOPS@publications.europa.eu"
  },
  "license": "EUPL-1.2",
  "homepage": "https://ted.europa.eu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OP-TED/efx-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/OP-TED/efx-vscode/issues"
  },
  "keywords": [
    "efx",
    "eforms"
  ],
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "efx",
        "aliases": [
          "EFX-2",
          "EFX"
        ],
        "extensions": [
          ".efx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "efx1",
        "aliases": [
          "EFX-1"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "efx.readAsTemplate",
        "title": "Read as Template",
        "category": "EFX"
      },
      {
        "command": "efx.readAsRules",
        "title": "Read as Rules",
        "category": "EFX"
      },
      {
        "command": "efx.chooseKind",
        "title": "Choose Template or Rules",
        "category": "EFX"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "efx.readAsTemplate",
          "when": "editorLangId == efx"
        },
        {
          "command": "efx.readAsRules",
          "when": "editorLangId == efx"
        },
        {
          "command": "efx.chooseKind",
          "when": "false"
        }
      ]
    },
    "grammars": [
      {
        "language": "efx",
        "scopeName": "source.efx2",
        "path": "./dist/efx2.tmLanguage.json"
      },
      {
        "language": "efx1",
        "scopeName": "source.efx1",
        "path": "./dist/efx1.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "efxWord",
        "superType": "keyword",
        "description": "A word of an EFX expression, or a word from a fixed list, such as and, present or rawValue."
      },
      {
        "id": "efxLiteral",
        "description": "An EFX literal that is neither a string nor a number, such as TRUE, a date or a duration."
      },
      {
        "id": "efxAssetName",
        "description": "The name of an asset in a label, of a codelist, a flag, a rule or a stage, in EFX."
      },
      {
        "id": "efxText",
        "description": "The text of an EFX template line."
      },
      {
        "id": "efxPunctuation",
        "description": "EFX punctuation, such as parentheses, commas and semicolons."
      },
      {
        "id": "efxBracket",
        "description": "The brackets of an EFX block: ${, #{, @{ and }."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "efx",
        "scopes": {
          "keyword": [
            "keyword.control.efx"
          ],
          "efxWord": [
            "keyword.other.efx"
          ],
          "type": [
            "storage.type.efx"
          ],
          "function.defaultLibrary": [
            "support.function.efx"
          ],
          "efxLiteral": [
            "constant.language.efx"
          ],
          "string": [
            "string.quoted.efx"
          ],
          "number": [
            "constant.numeric.efx"
          ],
          "property": [
            "variable.other.property.efx"
          ],
          "variable": [
            "variable.other.efx"
          ],
          "function": [
            "entity.name.function.efx"
          ],
          "efxAssetName": [
            "constant.other.efx"
          ],
          "efxText": [
            "meta.text.efx"
          ],
          "operator": [
            "keyword.operator.efx"
          ],
          "efxPunctuation": [
            "punctuation.separator.efx"
          ],
          "efxBracket": [
            "punctuation.section.block.efx"
          ],
          "comment": [
            "comment.line.double-slash.efx"
          ]
        }
      },
      {
        "language": "efx1",
        "scopes": {
          "keyword": [
            "keyword.control.efx"
          ],
          "efxWord": [
            "keyword.other.efx"
          ],
          "type": [
            "storage.type.efx"
          ],
          "function.defaultLibrary": [
            "support.function.efx"
          ],
          "efxLiteral": [
            "constant.language.efx"
          ],
          "string": [
            "string.quoted.efx"
          ],
          "number": [
            "constant.numeric.efx"
          ],
          "property": [
            "variable.other.property.efx"
          ],
          "variable": [
            "variable.other.efx"
          ],
          "function": [
            "entity.name.function.efx"
          ],
          "efxAssetName": [
            "constant.other.efx"
          ],
          "efxText": [
            "meta.text.efx"
          ],
          "operator": [
            "keyword.operator.efx"
          ],
          "efxPunctuation": [
            "punctuation.separator.efx"
          ],
          "efxBracket": [
            "punctuation.section.block.efx"
          ],
          "comment": [
            "comment.line.double-slash.efx"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[efx]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[efx1]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "files": [
    "dist",
    "language-configuration.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "tsc && node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies",
    "pretest": "npm run package && node scripts/build.mjs --tests",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@op-ted/efx-syntax-highlighter": "0.7.0"
  }
}
